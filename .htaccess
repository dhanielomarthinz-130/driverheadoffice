RewriteEngine On

# Disable Directory Indexing
Options -Indexes

# Security Headers (Defense-in-Depth)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
</IfModule>

# Protect Sensitive Files (Apache 2.2 & 2.4 Dual Compatible)
<FilesMatch "(?i)\.(env|log|sql|bak|dmp|ini|sh|config\.php|json|yml|yaml|md|text)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent access to hidden files & directories (e.g. .git, .env)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 1. Menghilangkan .php dari URL (Redirect jika akses manual .php)
# Jangan redirect POST request agar data tidak hilang (seperti Login)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Map URL tanpa ekstensi kembali ke file .php secara internal
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]
